---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/"><img src="/BWF_British_War_Foundry_logo_202607052225.jpeg" alt="" />British War Foundry</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			<a class="channel-link" href="https://www.youtube.com/@BritishWarFoundry" target="_blank" rel="noreferrer"><span class="youtube-mark">▶</span><span>Watch on YouTube</span></a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		text-decoration: none;
	}
	h2 img { width: 32px; height: 32px; object-fit: cover; border-radius: 50%; }
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	.channel-link { align-items: center; gap: 0.5rem; font-family: 'Courier New', monospace; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
	.youtube-mark { color: #ba4b2f; }
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
